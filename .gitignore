# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# …except the template, which holds no secrets and is how a new checkout
# learns what the app needs.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# prisma: generated client (regenerated via `pnpm db:generate`)
/src/lib/generated

# Section financial data. Bank exports and the budget spreadsheet are working
# files, not source: they carry real account numbers and member-identifying
# transactions, and they belong in the section's own storage rather than in a
# git history that every clone carries forever. A bank export was committed once
# (see README, "Working with section data") and had to be scrubbed out again.
*.csv
*.xlsx
*.xls
# Test fixtures are exempt: a parser test needs a sample file, and one written
# by hand has no real data in it. Anything under a __fixtures__ directory is
# assumed to be that. Keep it synthetic.
!**/__fixtures__/*.csv

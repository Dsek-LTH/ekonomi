# Editor defaults, so a file does not change shape depending on who opened it.
# There is no formatter in this repo on purpose: ESLint judges code, not layout,
# and a formatter would rewrite the comment blocks that carry most of the
# reasoning here. That makes these settings the only thing keeping whitespace
# consistent, which is why they are worth stating.
#
# https://editorconfig.org  Supported natively by VS Code, JetBrains and Vim.
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true
# Not a hard rule and nothing enforces it. The code sits around 80 and the
# comment blocks wrap by hand well short of this; it is here so an editor that
# draws a ruler draws it in the right place.
max_line_length = 100

# Tabs are part of the format.
[Makefile]
indent_style = tab

[*.md]
# Two trailing spaces are a line break in Markdown.
trim_trailing_whitespace = false

[*.py]
indent_size = 4

[*.{json,yml,yaml}]
indent_size = 2

# Generated by a package manager. Nothing here is hand-edited, and reformatting
# a lockfile is how you get a diff nobody can read.
[{pnpm-lock.yaml,docker/migrator/package-lock.json}]
indent_size = unset
insert_final_newline = unset

# Editor defaults, so a file does not change shape depending on who opened it.
# Prettier (.prettierrc.json, `pnpm format`) formats src/ and reads the same
# indent from its own config. These settings cover everything it does not touch
# and keep an editor in step with it while typing. Prettier leaves comments
# alone, so the hand-wrapped comment blocks keep their shape.
#
# https://editorconfig.org  Supported natively by VS Code, JetBrains and Vim.
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true
# Prettier wraps code at this width. Comment blocks wrap by hand well short of
# it. It is here so an editor that draws a ruler draws it in the right place.
max_line_length = 100

# Tabs are part of the format.
[Makefile]
indent_style = tab

[*.md]
# Two trailing spaces are a line break in Markdown.
trim_trailing_whitespace = false

[*.{json,yml,yaml}]
indent_size = 2

# Generated by a package manager. Nothing here is hand-edited, and reformatting
# a lockfile is how you get a diff nobody can read.
[{pnpm-lock.yaml,docker/migrator/package-lock.json}]
indent_size = unset
insert_final_newline = unset

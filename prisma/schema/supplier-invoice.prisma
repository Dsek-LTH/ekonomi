// Leverantörsfakturor: an invoice the section has been sent and has to pay,
// from the moment it lands in the inkorg until it has been attested and handed
// to Fortnox.
//
// Its own model rather than a fourth PaymentType on Expense. An utlägg is a
// member's claim on the section, and most of what Expense holds is about that
// member: who is owed, by when they must file, whose card it was on. An
// invoice has none of it. A supplier is owed, nobody files it, and it is paid
// through Fortnox's leverantörsreskontra rather than as a payout. What the two
// do share is the attest, which is why the allocation below has the same shape
// as ExpenseCostAllocation and is decided by the same rule
// (canAttestAllocation in lib/domain/permissions.ts).
//
// The section is momsbefriad, so there is no VAT anywhere in here. An amount is
// what the supplier asks for, and every krona of it is cost.

/// Where an invoice is. The path through it is
///
///   APPROVED → BOOKED → EXPORTED
///
/// An invoice is born when its unit fördelar it. Until then it is a document
/// in the Inkorg (see SupplierInvoiceDocument), given to a unit or not yet,
/// and an invoice sent back there stops being one: its documents return to
/// the Inkorg and the invoice goes.
///
/// The fördelning (which cost centres, how much each) signs the unit's own
/// rows in the same step, so an invoice with only the unit's rows is born
/// APPROVED. PENDING_APPROVAL is for one split with another unit, waiting for
/// that unit's signature, and CHANGES_REQUESTED is the way back with a
/// comment. The treasury then konterar it (BOOKED) and sends it to Fortnox as
/// a separate act, the way an utlägg is.
enum SupplierInvoiceStatus {
  /// Waiting for its unit to fördela it again: the split reopened, or the
  /// last signature on it taken back. Never where an invoice starts.
  ASSIGNED
  /// Attested for some of its rows, waiting for another unit to sign the rest.
  PENDING_APPROVAL
  /// Sent back with a comment, to be attested again.
  CHANGES_REQUESTED
  /// Every row attested. The treasurer konterar it.
  APPROVED
  /// Konterad: supplier, invoice facts and an account on every row, checked
  /// and saved. Waiting to be sent to Fortnox.
  BOOKED
  /// Created in Fortnox as an unbooked supplier invoice. Booking it and paying
  /// it happen there.
  EXPORTED
}

/// How the invoice got here.
enum SupplierInvoiceSource {
  /// Somebody holding INVOICE_TRIAGE put the PDF in by hand.
  UPLOAD
  /// Forwarded by mail to the inkorg address.
  EMAIL
}

enum SupplierInvoiceEventType {
  RECEIVED
  EDITED
  DOCUMENT_UPLOADED
  /// A document taken off and put back in the Inkorg. No longer written: the
  /// underlag stays on its invoice. Kept for the history that has it.
  DOCUMENT_REMOVED
  /// Given to a result unit, or moved from one to another. `diff` is
  /// `{ from: string | null, to: string }`, the unit names as they were then.
  ASSIGNED
  /// Some rows signed. `diff` is `{ costCenters: string[] }`, the codes.
  COST_CENTER_APPROVED
  /// A signature taken back, before the invoice went to Fortnox.
  ATTEST_WITHDRAWN
  CHANGES_REQUESTED
  /// The last row signed.
  APPROVED
  /// Konterad by the treasury, ready to be sent to Fortnox.
  BOOKED
  /// A document from the Inkorg added to it.
  DOCUMENT_ATTACHED
  /// Created in Fortnox. `comment` is the GivenNumber Fortnox gave it.
  EXPORTED
  /// An export whose outcome was unknown was looked up in Fortnox by the
  /// treasurer, found not to have made an invoice, and let go to try again.
  EXPORT_RELEASED
}

model SupplierInvoice {
  id        String                @id @default(cuid())
  /// Human-readable, "LEV26-0012", a series of its own beside the utlägg's
  /// DEK26-0042 (lib/domain/reference.ts). Taken when the invoice is made,
  /// which is when its unit fördelar it: a document that never got that far
  /// never had a number. Null only on invoices from before the numbering, until the
  /// migration gave them one. Pages and routes are keyed on `id`.
  reference String?               @unique
  status    SupplierInvoiceStatus
  source    SupplierInvoiceSource

  /// Who put it here: the uploader, or the member whose mail it came from.
  receivedBy   User?   @relation("SupplierInvoiceReceiver", fields: [receivedById], references: [id], onDelete: SetNull)
  receivedById String?

  /// What it is for, in a line, written by whoever knows. "Hyra av släp till
  /// nollningen" says more to an attester than a supplier's name does.
  description String?

  // ── What the invoice says ────────────────────────────────────────
  //
  // All nullable, because an invoice arrives as a PDF and nothing else. These
  // are the treasurer's to complete, not the attester's, and the export is
  // what requires them (lib/domain/supplier-invoice.ts). Free text where the
  // supplier writes free text: an org number, an OCR and a bankgiro are what is
  // printed on the invoice, and checking their shape here would only refuse an
  // invoice the section still has to pay.
  supplierName  String?
  supplierOrgNo String?
  invoiceNumber String?
  invoiceDate   DateTime? @db.Date
  dueDate       DateTime? @db.Date
  amount        Int? // öre
  /// Öresutjämning, öre, signed: what the invoice's lines came to less the
  /// amount to pay, rounded away. Booked on its own account at the export
  /// (bookedShares in lib/domain/supplier-invoice.ts). Under a krona.
  rounding      Int?
  currency      String    @default("SEK")
  ocr           String?
  bankgiro      String?
  plusgiro      String?
  /// "Er referens" as printed: a name, or the cost centre code a supplier was
  /// asked to put there. Read for the automatic assignment as well as shown.
  yourReference String?
  /// "Vår referens": who at the section the invoice concerns, written by the
  /// treasurer at the booking and sent to Fortnox as OurReference.
  ourReference  String?

  /// Which of the fields above were read from the PDF's text rather than
  /// typed, so the page can say so and the treasurer knows what to check.
  /// A field typed over afterwards is taken off the list.
  prefilled String[] @default([])

  // ── Fortnox ──────────────────────────────────────────────────────
  //
  // The supplier in Fortnox's register it is billed by, chosen by the
  // treasurer, and the number Fortnox gave the supplier invoice once made.
  fortnoxSupplierNumber String?
  fortnoxGivenNumber    String?
  exportedAt            DateTime?
  exportedBy            User?     @relation("SupplierInvoiceExporter", fields: [exportedById], references: [id], onDelete: SetNull)
  exportedById          String?

  // The export lock, the same as an utlägg's and for the same reason: Fortnox
  // has no delete for a supplier invoice made through the API, so one must
  // never be made twice. Taken before anything is sent, let go when the
  // export is recorded or certainly failed, and kept, UNCERTAIN, when Fortnox
  // did not say either way, until the treasurer has looked. See
  // api/supplier-invoices/[id]/export.
  exportClaimedBy   User?             @relation("SupplierInvoiceExportClaim", fields: [exportClaimedById], references: [id], onDelete: SetNull)
  exportClaimedById String?
  exportClaimedAt   DateTime?
  exportClaimState  ExportClaimState?

  // ── Whose it is ──────────────────────────────────────────────────
  //
  // The result unit answering for it, which is who konterar it. Not who attests
  // it. That is still decided per allocation from the cost centre's code, the
  // same as an utlägg, so an invoice split with another unit is signed for by
  // both. The unit its document was given to, carried over when it was made.
  resultUnit   ResultUnit? @relation(fields: [resultUnitId], references: [id], onDelete: SetNull)
  resultUnitId String?
  /// Who gave its document to the unit, carried over from the document. Null
  /// when it was given automatically, from what the forwarded mail said.
  assignedBy   User?       @relation("SupplierInvoiceAssigner", fields: [assignedById], references: [id], onDelete: SetNull)
  assignedById String?
  assignedAt   DateTime?

  /// The mail it came in, for an invoice that was forwarded rather than
  /// uploaded. One mail with three PDFs is three invoices pointing here.
  inboundMail   InboundMail? @relation(fields: [inboundMailId], references: [id], onDelete: SetNull)
  inboundMailId String?

  allocations SupplierInvoiceAllocation[]
  lines       SupplierInvoiceLine[]
  documents   SupplierInvoiceDocument[]
  events      SupplierInvoiceEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([inboundMailId])
  // The list is a status tab in arrival order, and a resultatansvarig's list is
  // that narrowed to their units. Each ends in `id` for the reason the indexes
  // on Expense do: a page is a window onto an ordering, and an ordering with
  // ties can show one row twice.
  @@index([status, createdAt, id])
  @@index([resultUnitId, status])
  @@index([dueDate, id])
}

/// One konteringsrad: a cost centre, how much, and the account it is booked on.
///
/// The cost centre is the attester's, and the account the treasurer's: the
/// resultatansvarig knows where the cost belongs, the treasurer knows the
/// chart of accounts. So the account is empty until the export step fills it.
model SupplierInvoiceAllocation {
  id           String          @id @default(cuid())
  invoice      SupplierInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  invoiceId    String
  costCenter   CostCenter      @relation(fields: [costCenterId], references: [id])
  costCenterId String
  /// BAS account number, as the treasurer set it on the row before the
  /// kontering had lines of its own. No longer written: the accounts are on
  /// SupplierInvoiceLine, and the migration that made it copied these there.
  account      String?
  /// Fortnox project number. No longer written, for the same reason.
  project      String?
  /// Öre. Null on an invoice with one row, which is the whole of it, whatever
  /// the amount turns out to be. A split names every row's share, and is the
  /// only time an attester types an amount.
  amount       Int?
  comment      String?

  approvedBy   User?     @relation("SupplierInvoiceAllocationApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedById String?
  approvedAt   DateTime?

  /// Where it comes among the invoice's rows, as the konterare wrote them.
  position Int @default(0)

  @@index([invoiceId])
  // "Every invoice touching one of these cost centres", which is how a
  // resultatansvarig's attest queue is resolved, as on ExpenseCostAllocation.
  @@index([costCenterId])
}

/// One line of the treasury's kontering of a levfaktura, as an utlägg's
/// verifikation has lines: what is sent to Fortnox as the supplier invoice's
/// rows. Free, the way any voucher is: the treasurer may add rows, move them,
/// and put a project or a cost centre on any of them. The attested split
/// (SupplierInvoiceAllocation) is what the lines start out from, and stays as
/// the record of what each unit signed for. The leverantörsskuld and the
/// öresutjämning are not lines: they follow from the invoice's amount and its
/// rounding, and are added at the export.
///
/// Replaced whole each time the kontering is saved, and dropped when the unit
/// fördelar the invoice again, since they were made from a split that is gone.
model SupplierInvoiceLine {
  id        String          @id @default(cuid())
  invoice   SupplierInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  invoiceId String
  position  Int
  /// BAS account number, "5410". Plain, like VerificationLine.account.
  account        String
  /// The cost centre's code, as Fortnox knows it. Null for none.
  costCenterCode String?
  /// Fortnox project number, or null.
  project        String?
  /// Fortnox's TransactionInformation for the row.
  description    String?
  /// Öre. One side or the other, never both.
  debit          Int     @default(0)
  credit         Int     @default(0)

  @@index([invoiceId])
}

/// A file that is, or may become, part of a levfaktura: usually its PDF,
/// sometimes a specification that only makes sense beside it.
///
/// With no invoice it is in the Inkorg. Everything that arrives lands there
/// first (forwarded mail, a hand upload), and triage gives it to a result
/// unit or deletes it. Given to a unit, it is in that unit's Inkorg, and the
/// unit fördelar it, which is what makes the invoice, or says it is not
/// theirs, which puts it back with triage. Once on an invoice it stays there,
/// since it is what the invoice is attested and booked on. It goes back to the
/// Inkorg only with the whole invoice, when that is sent back: a file is only
/// ever thrown away from the Inkorg, by somebody who has looked at it.
///
/// Only who it was given to is kept here, not a history. The history is the
/// invoice's, and starts when there is one.
model SupplierInvoiceDocument {
  id        String           @id @default(cuid())
  invoice   SupplierInvoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  invoiceId String?

  /// The mail it came in, for a forwarded one: who sent it and what they wrote,
  /// shown beside it in the Inkorg.
  inboundMail   InboundMail? @relation(fields: [inboundMailId], references: [id], onDelete: SetNull)
  inboundMailId String?

  /// The unit whose Inkorg it is in, while it is in one: given by triage, or
  /// automatically from what the forwarded mail said. Null while it waits for
  /// triage. Cleared once it is on an invoice, which has a unit of its own.
  resultUnit   ResultUnit? @relation(fields: [resultUnitId], references: [id], onDelete: SetNull)
  resultUnitId String?
  /// Who gave it to the unit. Null when it was given automatically.
  assignedBy   User?       @relation("SupplierInvoiceDocumentAssigner", fields: [assignedById], references: [id], onDelete: SetNull)
  assignedById String?
  assignedAt   DateTime?
  /// When it is due, as triage read it off the PDF when giving it to the
  /// unit, so the unit can tell what is urgent before it opens anything. Only
  /// offered: the unit's fördelning says the due date the invoice is made with.
  dueDate      DateTime?   @db.Date

  /// For a document back with triage: which unit it came back from, and why,
  /// as whoever sent it back wrote it ("Det här är Caféets"). Cleared when it
  /// is given to a unit again.
  returnedFrom String?
  returnNote   String?

  objectKey String
  filename  String
  mimeType  String
  byteSize  Int?

  /// What the PDF's text layer says (lib/domain/invoice-text.ts), read once
  /// when its unit opens the fördelning and kept, so it is never read twice.
  /// Nothing is read on arrival: the Inkorg shows the file, who sent it and
  /// when, and nothing interpreted. An InvoiceTextFields, `{}` when nothing was
  /// found (a scan, a photo). Null until read.
  scan      Json?
  scannedAt DateTime?

  uploadedBy   User?   @relation("SupplierInvoiceDocumentUploader", fields: [uploadedById], references: [id], onDelete: SetNull)
  uploadedById String?

  position Int @default(0)

  createdAt DateTime @default(now())

  @@index([invoiceId, createdAt])
  @@index([inboundMailId])
  @@index([resultUnitId])
}

model SupplierInvoiceEvent {
  id        String                   @id @default(cuid())
  invoice   SupplierInvoice          @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  invoiceId String
  type      SupplierInvoiceEventType

  actor   User?   @relation("SupplierInvoiceEventActor", fields: [actorId], references: [id], onDelete: SetNull)
  actorId String?

  comment String?
  diff    Json?

  createdAt DateTime @default(now())

  @@index([invoiceId])
}

/// Fortnox's supplier register, as it was last read: what a document in the
/// Inkorg is matched against, by org number or giro, to say who sent it.
///
/// A copy because the register is only readable through the treasurer's own
/// login (the service account has no `supplier` scope), and a document arrives
/// by mail with nobody logged in. Refreshed every time the treasurer's export
/// step reads the register, and when a supplier is added from there, so it is
/// as fresh as the last invoice exported. Nothing is decided on it: the export
/// reads the register itself.
model Supplier {
  /// Fortnox's SupplierNumber.
  number   String  @id
  name     String
  orgNo    String?
  bankgiro String?
  plusgiro String?
  active   Boolean @default(true)

  syncedAt DateTime @default(now())
}

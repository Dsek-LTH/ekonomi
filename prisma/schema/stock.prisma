// Alkohollager: the bar's stock, kept because a serving permit requires a
// lagerbokföring that holds up when somebody asks to see it.

// ─────────────────────────────────────────────────────────────────────────────
// Alkohollager: the bar's stock, and the law's reason for it.
//
// Serving alcohol under a permit means keeping a lagerbokföring: a record of
// what came in, what went out, and what is on the shelf, that holds up when
// somebody asks to see it. Two things follow from that and shape everything
// below.
//
// The log is the record. `StockEntry` is append-only, never updated and never
// deleted, and what is on hand is the sum of it, not a column somebody edits.
// A quantity that can be quietly changed is a quantity nobody can defend; a log
// that can be replayed is. Mistakes are corrected by a new row naming the row it
// corrects (`correctsId`), which is also how a stocktake's discrepancy is
// written.
//
// And the measurement is kept, not just its conclusion. Spirits are measured by
// weighing the bottle, and grams become millilitres through the product's own
// calibration (see lib/stock/measure.ts). The grams are stored, so a tare
// corrected later can be applied to every historical figure. Store only the
// derived volume and a wrong constant is baked into the legal record for good.

/// How a product's stock is counted.
enum StockKind {
  /// Cans, bottles of beer, wares: whole units, and a delivery carries a
  /// best-before date.
  UNIT
  /// Spirits. Sealed bottles are counted; opened ones are counted at the fill
  /// level somebody eyeballed them at: 80, 60, 40 or 20 per cent.
  ///
  /// Nothing is measured, because nothing is measurable here: the bar looks at
  /// a bottle and calls it a quarter, a half, three quarters. A model carrying
  /// millilitres would be stating a precision the estimate does not have.
  VOLUME
}

/// The drink types the bar keeps its stock in, and files its report against.
///
/// Every one of them needs a purchased volume on the restaurangrapport, so
/// there is no longer a "reported" subset. The whole list is reported, which
/// is why nothing here asks which of them count.
///
/// OL covers beer of every strength. Folkhälsomyndigheten's own form splits
/// starköl from folköl and asks a purchased volume only for the former, so if
/// the bar ever serves folköl this enum has to grow a value back before the
/// report can be filed from it.
enum DrinkCategory {
  SPRITDRYCK
  VIN
  OVRIG_JASTDRYCK
  OL
  ALKOHOLDRYCKSLIKNANDE
}

/// Why stock moved. Kept apart because the report keeps them apart: what was
/// bought is reported, what was served is turnover, and what was spilled is
/// neither.
enum StockEntryKind {
  /// Bought in. The only kind whose volume reaches the restaurangrapport's
  /// "inköpt volym".
  PURCHASE
  /// Left the store for a pub or a sittning, and is expected back.
  CHECKOUT
  /// Came back from one, at whatever level the bottles are now at. The only
  /// kind that may put a bottle *onto* the ladder or move it up it, because it
  /// is the only moment anybody looks at a bottle and judges it.
  RETURN
  /// Spilled, broken, poured away, out of date.
  ///
  /// There is no SERVING beside it. Drink is served from what was taken to a
  /// pub, so what was drunk is the difference between the checkout and the
  /// return, never a movement anybody types. A kind for it would have been
  /// unreachable from the app and would have meant the same thing as a return
  /// that came home lower, which is how the old REJECTED status went wrong.
  WASTE
  /// What a count found that the log did not predict.
  COUNT
  /// An entry undoing or amending an earlier one. Never an edit.
  CORRECTION
  /// Destroyed in the cellar: dropped on the stairs, broken in the crate it
  /// arrived in, out of date on the shelf.
  ///
  /// Its own kind rather than a WASTE with no event, because the two differ in
  /// the one way the books care about: where the stock was standing when it was
  /// destroyed. A spill at a pub is stock that left the cellar at CHECKOUT and
  /// was already off the shelf, which is the whole reason WASTE carries
  /// `spilledQty` and moves nothing. This is stock that never left, so it comes
  /// off the shelf here, as an ordinary negative movement priced at the moving
  /// average, exactly the way a checkout is.
  ///
  /// So it never carries an event and never carries `spilledQty`, and every
  /// rule already written for a removal applies to it unread. Anybody asking
  /// what a term's svinn cost wants the two added together, which is one line
  /// in lib/data/stock-stats.ts rather than a shape both kinds have to share.
  ///
  /// Last in the enum because Postgres appends: keeping the order the database
  /// has is what stops a later migration wanting to rewrite the type.
  SPOILAGE
}

/// A thing the bar keeps a stock of.
model StockProduct {
  id       String        @id @default(cuid())
  name     String
  kind     StockKind
  category DrinkCategory

  /// The barcode on the tin or the bottle. Unique, so scanning one in the
  /// cellar identifies the product outright; null for anything without one.
  ean String? @unique

  /// Systembolaget's article number, the digits at the end of the product's
  /// URL, e.g. 141215 in
  /// `systembolaget.se/produkt/ol/norrlands-guld-141215/`.
  ///
  /// Stored as text rather than an integer: it is an identifier the way a
  /// barcode is, never arithmetic, and a leading zero in one would be a digit
  /// lost. Not unique, because the same article can be kept as two products (a
  /// 33 cl can and a 50 cl bottle share neither EAN nor article number, but a
  /// re-listed article can repeat), and a uniqueness error at save time would
  /// be a worse answer than two rows an operator can see.
  systembolagetId String?

  /// Alcohol by volume, per cent: 40.00 for vodka, null for wares.
  ///
  /// Litres of pure alcohol is volume × this, and nothing else can reconstruct
  /// it afterwards.
  abv Decimal? @db.Decimal(5, 2)

  /// UNIT: what one unit holds, in millilitres. 330 for a can. This is what
  /// turns a count of cans into the litres the report asks for.
  unitMl Int?

  /// VOLUME: the bottle as sold, in millilitres, so 700. What a sealed bottle
  /// holds, and the whole an open one's level is a fraction of.
  nominalMl Int?

  /// What one whole unit costs to buy, in öre: a sealed bottle, a can.
  ///
  /// The only price a product carries. What the bar *charges* is not tracked
  /// here: a stock is valued at what it cost, and the restaurangrapport's
  /// normalpris belongs with the turnover figures, which come from the income
  /// side of the app rather than from a shelf.
  ///
  /// What the stock is worth is the sum of `StockEntry.valueDeltaOre`, never
  /// this times a count. See lib/stock/value.ts.
  costPriceOre Int?

  /// How long this keeps from the day it is delivered, in whole months.
  ///
  /// A fact about the product rather than about a crate, which is the only
  /// place it can live: nothing is written on the crates, they get mixed on the
  /// shelf, and they come off it in whatever order somebody reaches. So the app
  /// never claims to know a real best-before date. It knows that a lager keeps
  /// about nine months and a cider about twenty-one, and that a delivery from
  /// March is therefore worth going and looking at before Christmas.
  ///
  /// Months rather than days because that is how the answer is known. Nobody
  /// says a beer keeps 274 days.
  ///
  /// Null where nobody has said, and on everything that does not go off. A
  /// product with no figure here raises no checks at all, which is the gap
  /// showing as a gap rather than as a default nobody believes. See
  /// lib/stock/expiry.ts.
  shelfLifeMonths Int?

  /// Free labels the cellar sorts by: "whisky", "cognac", "vodka".
  ///
  /// Optional, and a tag exists by being carried. There is no table of them:
  /// what the picker offers is what the products already say, so a tag is made
  /// by typing it on the first product that wants it and is gone when the last
  /// one drops it. Renaming one across the shelf is an update over the products
  /// that hold it, which is the price of not keeping a second thing in step
  /// with this one.
  ///
  /// Stored as typed, matched case-insensitively: see lib/stock/tags.ts, which
  /// is what both the route and the picker fold with, so "Whisky" and "whisky"
  /// cannot both end up in the list.
  tags String[] @default([])

  entries StockEntry[]
  changes StockChange[]
  edits   StockProductChange[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  /// GIN, because the question asked of this column is "which products carry
  /// this tag", and a btree cannot answer a containment test.
  @@index([tags], type: Gin)
}

/// One movement of stock. The log, and the only thing that is true.
///
/// Every quantity is a signed delta, positive in and negative out, so on hand is
/// their sum and nothing has to be kept in step with anything. There is no
/// PATCH and no DELETE on this table anywhere in the app.
model StockEntry {
  id String @id @default(cuid())

  productId String
  product   StockProduct @relation(fields: [productId], references: [id], onDelete: Restrict)

  kind StockEntryKind

  /// Whole units: cans for a UNIT product, *sealed* bottles for a VOLUME one.
  units Int @default(0)

  /// Open bottles, at the four levels the bar estimates them at.
  ///
  /// Four columns rather than a child table, because the ladder is fixed by how
  /// a person looks at a bottle rather than by anything configurable, and
  /// because this way the whole shelf is one `SUM()` with no join. Changing the
  /// ladder is a migration, which is the honest price of it being this cheap.
  ///
  /// Signed, like everything else here. Taking the 40 % bottle out is
  /// `open40: -1`; a bottle coming back lower is one level down and another up
  /// in the same row.
  open80 Int @default(0)
  open60 Int @default(0)
  open40 Int @default(0)
  open20 Int @default(0)

  /// How many things a spill on an event destroyed: cans, or bottles.
  ///
  /// Its own column because a spill under an event must not move the shelf. The
  /// stock left the cellar when it was checked out; subtracting it again here
  /// would remove it twice, and the crate would come up two short at the next
  /// stocktake. So the quantity columns above stay at nothing for a spill and
  /// this pair carries what was lost.
  ///
  /// A count rather than a volume, like everything else here. It used to hold
  /// millilitres for a spirit, which meant nobody could say "we dropped one".
  /// They had to work out what was in it first, and the figure could not be
  /// read back as the thing that happened.
  spilledQty Int @default(0)

  /// Which rung this row is about: 0 for a whole thing (a sealed bottle, or
  /// any can) and 80/60/40/20 for an opened one.
  ///
  /// It says nothing the columns above do not already imply. It is here so the
  /// database can *enforce* what the sheet means: with the unique index below,
  /// one event has at most one row per product, direction and rung. That is
  /// what makes a cell on the sheet a row in the table rather than a running
  /// total of however many rows happen to have been written, and it is what
  /// lets a figure be corrected by being changed instead of by being cancelled
  /// out with a second row nobody wanted to read.
  ///
  /// Zero rather than null on purpose: Postgres counts nulls as distinct in a
  /// unique index, so a nullable rung would let a product's whole-bottle cell
  /// be written twice over.
  level Int @default(0)

  /// What one whole unit of this product cost, in öre, when this row was
  /// written.
  ///
  /// Copied off the product at that moment and never read from it again. That
  /// is the whole point: a price is a fact about the day stock arrived, not a
  /// property of the product that reaches backwards. Correcting a product's
  /// price changes what the *next* delivery will be booked at and nothing else,
  /// which is how every inventory system worth the name behaves.
  ///
  /// What uses it: a row that brings stock in is worth this times what arrived.
  /// A row that takes stock out is priced by the moving average at that moment
  /// instead, and ignores this, but it is captured on every row all the same so
  /// that replaying a product's value never has to consult anything that can
  /// change underneath it. See lib/stock/value.ts.
  ///
  /// Null where nobody had priced the product. That is a gap showing as a gap:
  /// the stock is worth nothing until somebody says what it cost.
  unitCostOre Int?

  /// On a delivery: roughly when this stops being worth drinking.
  ///
  /// Worked out when the row is written, from the day it arrived and the
  /// product's `shelfLifeMonths`, and never read from the product again. The
  /// same rule as `unitCostOre` above and for the same reason: what a delivery
  /// keeps is a fact about the day it arrived, and correcting a product's shelf
  /// life changes what the *next* delivery will be watched for rather than
  /// reaching backwards into deliveries somebody has already checked.
  ///
  /// It is also the one place a real date can be typed. Where somebody has
  /// actually read the crate, this is what they overwrite, and from then on the
  /// row carries a fact instead of an estimate.
  ///
  /// Null on a product with no shelf life, and on everything that is not a
  /// delivery. Nothing else brings stock into the building with an age.
  bestBefore DateTime? @db.Date

  /// When somebody last stood at the shelf and said this delivery was still
  /// fine.
  ///
  /// What makes a warning dismissable, which is what stops the list filling up
  /// with checks nobody can clear. It pushes the next check out by the lead
  /// time rather than silencing the row for good: a crate looked at in December
  /// still wants looking at in January.
  ///
  /// Set across every outstanding delivery of a product at once, because that
  /// is what physically happened. Somebody looked at the shelf, not at a crate.
  checkedAt DateTime? @db.Date

  /// On a stocktake: what was actually counted at this rung.
  ///
  /// The row still stores a difference in the columns above, because the log is
  /// a log of differences. But a count is a *statement* about the shelf, and
  /// the statement is the absolute. Keeping it is what lets the difference be
  /// worked out again whenever anything before the count changes, which is what
  /// makes an inventering mean what everybody already thinks it means: at this
  /// date the stock was this, and that is the baseline. Without it, correcting
  /// an old delivery quietly moved every figure after the count too.
  ///
  /// Null on everything that is not a count, and on counts written before this
  /// existed, because nothing recorded what those were counting, so their difference
  /// is left exactly as it was given. See lib/stock/replay.ts.
  countedQty Int?

  /// The event this belongs to. See StockEvent. Required for the three kinds
  /// that make up a night, absent on a delivery or a stocktake.
  ///
  /// Also half of what makes a row a cell: the unique index below applies only
  /// where this is set, because Postgres treats nulls as distinct. A delivery
  /// may therefore repeat as often as deliveries do, while a night's Ut figure
  /// for a product is one row that gets edited.
  eventId String?
  event   StockEvent? @relation(fields: [eventId], references: [id], onDelete: Restrict)

  /// What this movement did to the value of the stock, in öre.
  ///
  /// It rides on `units` alone. An open bottle is worth nothing to the stock,
  /// which is what makes "written off the moment it is opened" free rather than
  /// a special case: opening one *is* the sealed count falling with no purchase
  /// behind it.
  ///
  /// Positive on a purchase: what was actually paid. Negative on sealed bottles
  /// leaving, at the moving average cost at that moment, computed on the way
  /// in and never afterwards, because the average moves with every purchase and
  /// a figure recomputed later would not be what this movement was worth.
  ///
  /// The stock's value is the sum of this column, the same way its quantity is
  /// the sum of the two above. Emptying a product takes its value to exactly
  /// zero. See `costOfRemoval` in lib/stock/value.ts.
  valueDeltaOre Int @default(0)

  /// When it happened in the world, and when somebody wrote it down. They
  /// differ often (a Friday's serving entered on Monday) and the gap is the
  /// sort of thing an inspection asks about, so both are kept.
  occurredAt DateTime @db.Date

  actorId String
  actor   User   @relation("StockEntryActor", fields: [actorId], references: [id], onDelete: Restrict)

  /// The utlägg this was bought on. The receipt is already in this app, so a
  /// purchase row points at it rather than asking for the paperwork twice.
  expenseId String?
  expense   Expense? @relation("StockPurchaseExpense", fields: [expenseId], references: [id], onDelete: SetNull)

  /// A correction names what it corrects. Self-relation, so the chain is
  /// readable in both directions.
  correctsId  String?
  corrects    StockEntry?  @relation("StockCorrection", fields: [correctsId], references: [id], onDelete: Restrict)
  correctedBy StockEntry[] @relation("StockCorrection")

  note String?

  createdAt DateTime @default(now())

  /// One event, one product, one direction, one rung: one row.
  ///
  /// The sheet's cell, enforced. Without it "the Ut figure for this beer on
  /// this night" is whatever a sum over some rows comes to, and correcting it
  /// means adding another row, which is where the log filled up with movements
  /// nobody made. Rows with no event are exempt because `eventId` is null on them and
  /// Postgres counts nulls as distinct, which is the behaviour wanted here: a
  /// cellar takes as many deliveries of a product as it takes.
  @@unique([eventId, productId, kind, level])
  /// Which deliveries are due a look: a range over the date, and most rows do
  /// not have one.
  @@index([bestBefore])
  @@index([productId, occurredAt])
  @@index([occurredAt])
  @@index([kind, occurredAt])
  @@index([eventId])
}

/// An event stock is taken out for: a pub, a sittning, a party.
///
/// It exists because a night is not a date. A pub that runs past midnight is
/// two dates, a committee may take stock out twice in an evening, and two
/// events can run on one night, so grouping by day, or by "the last checkout",
/// answers none of them. The event says which movements belong together, and
/// once they are grouped the arithmetic is the whole of what a night sold:
///
///   sold = taken out − brought back − spilled
///
/// Deliberately never closed. What is still on the bar and what has been drunk
/// are the same number until somebody carries the crates back, and a status
/// that claimed to know the difference would be a status somebody had to
/// remember to set. An event mid-flight simply reads as having sold what is
/// currently out, and its page says as much.
/// What somebody did to a stock row, as opposed to what the row says.
///
/// The stock log answers "what happened to our stock"; this answers "who did
/// that". They were one thing for a while and it served neither: every
/// correction showed up in the ledger as a movement, so a mistyped delivery of
/// 200 bottles stayed on the books forever as a purchase that never happened,
/// with a second row cancelling it.
///
/// Now a row is edited in place and this records the edit. Which is also what
/// makes editing defensible. The alcohol act asks that the bookkeeping be
/// arranged so the activity can be checked, and an editable ledger with no
/// record of its edits is not that.
///
/// Deliberately not a relation to StockEntry. A row that is removed is *gone*
/// from the ledger. It was a mistake, not a movement, and leaving it behind a
/// "deleted" flag would mean every `SUM()` over the log needed to remember to
/// exclude it, which is one forgotten `where` away from a wrong shelf. So the
/// entry id is kept as plain text and this table outlives what it describes.
model StockChange {
  id String @id @default(cuid())

  /// The row this happened to. Plain text: it may no longer exist.
  entryId String

  /// Read two ways, which is the whole point of keying it like this: everything
  /// that happened to an event, and everything that happened to a product.
  /// A delivery has no event, and it is the deliveries that most need the
  /// second reading.
  productId String
  product   StockProduct @relation(fields: [productId], references: [id], onDelete: Restrict)
  eventId   String?
  event     StockEvent?  @relation(fields: [eventId], references: [id], onDelete: Restrict)

  action StockChangeAction

  /// What sort of movement it was, and which rung. Enough to name the cell in
  /// a sentence without joining back to a row that may be gone.
  kind  StockEntryKind
  level Int            @default(0)

  /// The figure as the person saw it: what the cell said before, and after.
  /// Null on the side that does not exist. A row being made has no before, and
  /// one being removed has no after.
  ///
  /// The cell's own figure rather than the ledger's signed delta: 24 out reads
  /// as 24 here, because 24 is what somebody typed and this is a record of what
  /// people did.
  fromQty Int?
  toQty   Int?

  /// The same, for the price a row was booked at.
  ///
  /// A delivery captures what a unit cost when it was written
  /// (StockEntry.unitCostOre) and nothing may move it afterwards, because a
  /// price is a fact about the day stock arrived. The one exception is the
  /// price having been wrong from the start, and that is not an edit somebody
  /// should be able to make quietly: correcting it re-values every movement of
  /// that product after it, so what it was, what it became and who decided that
  /// is recorded here.
  ///
  /// Null on a row that only moved a quantity, which is most of them. A single
  /// change may carry both.
  fromUnitCostOre Int?
  toUnitCostOre   Int?

  at      DateTime @default(now())
  actorId String
  actor   User     @relation("StockChangeActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([eventId, at])
  @@index([productId, at])
  @@index([entryId])
}

/// What was changed on a product, and by whom.
///
/// The entry log next door records what happened to the *stock*: rows written,
/// corrected, removed. Nothing recorded what happened to the product itself,
/// so a cost price could be corrected from 149 to 249 by anyone with stock
/// rights and the only trace was that figures started coming out differently.
///
/// Deliberately a trail rather than a table of prices over time. What a
/// delivery cost is already on the delivery (StockEntry.unitCostOre), which is
/// where valuation reads it and the only place it touches money; what was
/// missing is who typed a figure and when. A price list with dates would answer
/// "what did we think it cost in March", which nothing in the app asks, and
/// would put "the current price" in two places at once.
///
/// Everything is text, including the figures. This is read, not computed on:
/// the field's own name and the two spellings of it are what a person needs to
/// see what somebody did.
model StockProductChange {
  id String @id @default(cuid())

  productId String
  product   StockProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  /// The field as the API names it: "costPriceOre", "name", "abv". Not a
  /// translated label: the log outlives the wording of any screen.
  field String

  /// As it stood, and as it stands. Null where the field held nothing.
  fromValue String?
  toValue   String?

  at      DateTime @default(now())
  actorId String
  actor   User     @relation("StockProductChangeActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([productId, at])
}

enum StockChangeAction {
  CREATE
  UPDATE
  DELETE
}

// The stock feature's own settings. One row, like BookkeepingSettings.
//
// Everything here is a policy rather than a fact: a number somebody chose, not
// one the world handed us. Facts about a product live on the product.
model StockSettings {
  id String @id @default("singleton")

  /// How many days before a delivery's best-before to start asking about it.
  ///
  /// A policy and therefore section-wide, not a property of any product. A
  /// lager keeps nine months and a cider twenty-one, and both want the same
  /// amount of notice, because the notice is about how long it takes to drink a
  /// crate once somebody knows it needs drinking.
  ///
  /// Folding it into the product's own figure would have been the cheaper
  /// schema and the wrong one: changing your mind about how much warning you
  /// want would then mean editing every product on the shelf.
  expiryLeadDays Int @default(30)

  updatedAt DateTime @updatedAt
}

model StockEvent {
  id   String   @id @default(cuid())
  name String
  /// The night it is about, which is not the same as when its rows were
  /// written. A Friday pub is entered on the Monday as often as not.
  date DateTime @db.Date

  entries StockEntry[]
  changes StockChange[]

  createdAt DateTime @default(now())
  actorId   String
  actor     User     @relation("StockEventCreator", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([date, name])
}

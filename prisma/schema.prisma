// Prisma schema for the utlägg (expense) service.
//
// Money is stored as integer öre (minor units) everywhere — no floats — to keep
// accounting exact and clean for Fortnox export. Divide by 100 for display,
// multiply by 100 on import; lib/domain/money.ts is the only place that does
// either.
//
// "Everywhere" now means everywhere. BudgetAdjustment.amount was a Float
// holding kronor, and the budget engine reported kronor to match it, so the one
// part of the app whose whole job is arithmetic was the part not following the
// rule. Both are öre as of the 20260807 migrations. The engine still *computes*
// in kronor, because a budget formula multiplies money by things that are not
// money — a headcount, a percentage — and scaling those by 100 would be wrong;
// see the units note at the top of lib/budget/eval.ts.

generator client {
  provider = "prisma-client"
  output   = "../src/lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
  // Connection URL lives in prisma.config.ts (Prisma 7 moved it out of the schema).
}

// ── Enums ─────────────────────────────────────────────────────────

// Section role. A user may hold several (e.g. skattförman + resultatansvarig),
// so it's stored as an array. Access and attest authority are derived from the
// set of roles in lib/permissions.ts — never from a single value.
//   SKATTMASTARE / ORDFORANDE       — admins; full access; attest any expense but their own
//   VICE_SKATTMASTARE               — bookkeeping; attest expenses by "ordinarie" submitters
//   SKATTFORMAN                     — bookkeeping (book + return wrongly-approved)
//   RESULTATANSVARIG                — attest/handle expenses for the result unit(s) they answer for
//   ORDINARIE                       — regular functionary; submits own expenses
enum Role {
  SKATTMASTARE
  ORDFORANDE
  VICE_SKATTMASTARE
  SKATTFORMAN
  RESULTATANSVARIG
  // Runs the bar's stock. Deliberately outside the treasury roles: keeping the
  // lagerbokföring is not bookkeeping, and the people who do it are not the
  // people who book vouchers. See canManageStock in lib/domain/permissions.ts.
  STOCKARE
  ORDINARIE
}

enum PaymentType {
  CARD // section card — matched against the purchase before signing
  REIMBURSEMENT // out-of-pocket — matched against the payout after signing
}

// One value per state a reader can be in, and no more. There used to be a
// REJECTED alongside CHANGES_REQUESTED, unreachable from the app and meaning
// the same thing to anybody looking at it — so every query that filtered on
// status had to remember to match both, and the mapper had to translate one
// into the other on the way out. Three places each did that separately. The
// rows were migrated and the value dropped; see the
// 20260807_drop_rejected_status migration.
enum ExpenseStatus {
  DRAFT
  PENDING_MATCH
  PENDING_APPROVAL
  CHANGES_REQUESTED
  APPROVED
  BOOKED
  EXPORTED
}

// Structured audit trail. The app renders human-readable (Swedish)
// labels from the type; the database stays language-neutral and queryable.
enum ExpenseEventType {
  CREATED
  EDITED
  RECEIPT_UPLOADED
  MATCHED
  UNMATCHED
  SUBMITTED
  CHANGES_REQUESTED
  COST_CENTER_APPROVED
  ATTEST_WITHDRAWN
  APPROVED
  BOOKED
  EXPORTED
  EXPORT_REVERTED
}

// ── Models ────────────────────────────────────────────────────────

model User {
  id String @id @default(cuid())

  // Authentik's `preferred_username` — the LTH student id ("lu1234ge-s"), and
  // the identity this app is keyed on. It is the one thing about a member that
  // does not change: an email address can be re-pointed and a name can be
  // changed, and neither should make somebody a different person here. Same
  // key the guild's own web app uses (Member.studentId), so a future
  // integration has something to join on.
  studentId String @unique

  // Descriptive, not identifying. Refreshed from Authentik on each sign-in.
  email String @unique
  name  String

  // Derived from the Authentik group list on sign-in and on every token
  // refresh (lib/server/authentik-roles.ts). Authority is still read from this
  // column and never from the token — see lib/server/current-user.ts.
  roles Role[] @default([ORDINARIE]) // one or more section roles; authority derived in lib/permissions.ts

  // Bank details for REIMBURSEMENT payouts (Swedish clearing + account no.)
  bankClearingNumber String?
  bankAccountNumber  String?

  active Boolean @default(true)

  submittedExpenses    Expense[]               @relation("ExpenseSubmitter")
  allocationApprovals  ExpenseCostAllocation[] @relation("AllocationApprover")
  uploadedReceipts     Receipt[]               @relation("ReceiptUploader")
  events               ExpenseEvent[]          @relation("EventActor")
  createdVerifications Verification[]          @relation("VerificationCreator")
  heldCards            Card[]                  @relation("CardHolder")
  budgets              Budget[]                @relation("BudgetAuthor")
  lockedBudgets        Budget[]                @relation("BudgetLocker")
  budgetComments       BudgetComment[]         @relation("BudgetCommentAuthor")
  budgetChanges        BudgetChange[]          @relation("BudgetChangeAuthor")
  revokedBudgetChanges BudgetChange[]          @relation("BudgetChangeRevoker")
  fortnoxConnections   FortnoxConnection[]     @relation("FortnoxConnector")
  fortnoxSession       FortnoxUserSession?     @relation("FortnoxUserSession")
  resultUnitOwnerships ResultUnitOwner[]       @relation("ResultUnitOwnerUser")
  incomeBatches        IncomeBatch[]           @relation("IncomeBatchCreator")
  stockEntries         StockEntry[]            @relation("StockEntryActor")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Kostnadsställe — the org unit an expense is booked against.
// Which result unit a cost centre belongs to is NOT stored here — it is derived
// from ResultUnitPrefix by matching this `code`, so the two can never drift and
// a Fortnox sync has nothing to preserve. See lib/result-units.ts.
// Where a cost centre came from, and therefore who owns its lifecycle.
// FORTNOX rows are a mirror: the sync creates, renames and retires them.
// LOCAL rows are created here by an admin and the sync must leave them alone —
// they exist for dimensions Fortnox has no cost centre for (alcohol bought for
// resale books to a balance account, and for a budget being drafted the cost
// centre may not exist in Fortnox yet). They are never sent to Fortnox.
enum CostCenterSource {
  FORTNOX
  LOCAL
}

model CostCenter {
  id     String           @id @default(cuid())
  code   String           @unique // e.g. "NÄRU" or "SKT01"
  name   String
  active Boolean          @default(true)
  source CostCenterSource @default(FORTNOX)

  allocations       ExpenseCostAllocation[]
  verificationLines VerificationLine[]
  budgetCostCenters BudgetCostCenter[]

  incomeUnits       ResultUnitIncome[]    @relation("IncomeDefaultCostCenter")
  incomeReports     IncomeReport[]
  zettleFeeSettings BookkeepingSettings[] @relation("ZettleFeeCostCenter")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// The BAS chart of accounts, mirrored from Fortnox (/3/accounts). Replaces the
// short hardcoded list this app shipped with: it backs the account picker when
// booking an expense and validates the accounts a budget refers to. Synced by
// upsert — accounts are never deleted, since a budget or verification may still
// reference one that Fortnox has since retired.
model Account {
  number String  @id // BAS account number, e.g. "6071"
  name   String
  active Boolean @default(true) // Active in Fortnox; inactive stays selectable-but-hidden
  sru    String? // Fortnox SRU code, informational

  lastSyncAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([active])
}

// App-wide bookkeeping configuration. A single row (id "singleton"): these are
// the accounts the booking view pre-fills, which used to be the ACCOUNT.BANK /
// ACCOUNT.MEMBER_DEBT constants in lib/accounts.ts. Kept apart from
// FortnoxConnection so that disconnecting Fortnox doesn't discard them.
model BookkeepingSettings {
  id String @id @default("singleton")

  // Debited when a card purchase is booked.
  bankAccount       String @default("1930")
  // Credited when a member is owed a reimbursement.
  memberDebtAccount String @default("2890")

  // ── Income (intäkter) ──
  // The other side of the same idea: where money *arrives*. An income report is
  // booked by crediting the revenue accounts its products routed to and
  // debiting the account the money actually landed in, which depends on how it
  // was paid. These are the app's own settings, not intakt's — the service
  // returns what was sold and never decides which account it clears through.
  zettleClearingAccount String      @default("1930")
  swishClearingAccount  String      @default("1931")
  // Zettle's own transaction fees are a cost, not income: debited here and
  // credited against the Zettle clearing account above.
  zettleFeeAccount      String      @default("6570")
  // Cost centre the fee vouchers carry. Fees are not attributable to a
  // committee the way sales are — they belong to whoever runs the terminal.
  zettleFeeCostCenter   CostCenter? @relation("ZettleFeeCostCenter", fields: [zettleFeeCostCenterId], references: [id], onDelete: SetNull)
  zettleFeeCostCenterId String?
  // Which verifikationsserie a day's takings are filed under in Fortnox.
  //
  // Null means "the same one everything else uses" — FortnoxConnection's
  // voucherSeries — which is what every export did before this column existed.
  // Set, it separates a term of Swish from the utlägg they would otherwise be
  // interleaved with, and it is also the series the duplicate check reads: a
  // day is recognised over there by its series, its date and its voucher text
  // (lib/income/duplicate.ts), so the two must be decided in one place.
  incomeVoucherSeries   String?

  updatedAt DateTime @updatedAt
}

// ── Income routing (intäkter) ─────────────────────────────────────
// The table that decides which committee and which revenue account a sold
// product belongs to. This is intakt's config.yaml, moved into the database so
// it can be edited in the app rather than in a file on the treasurer's laptop —
// and so there is one copy of it. The app serialises these rows into the
// request it sends the intakt service; the service holds no configuration of
// its own.

// The income half of a resultatenhet: what it is called on an intäktsräkning,
// what its verifikation says, and which products route to it.
//
// This used to be IncomeCommittee — a second list of the section's verksamheter
// beside ResultUnit, maintained on another screen, with nothing checking that
// the two agreed. They are one thing: Sexmästeriet is a result unit that also
// sells beer. So a unit that takes money in has one of these, and a unit that
// does not simply has none.
//
// Optional on purpose, in both directions. Income runs on a database with no
// result units worth the name (every profile can carry its own, created for it),
// and result units, attest and the budget never read this table — which is what
// keeps the two halves of the app separable. Nothing here is required to attest
// an utlägg, and nothing in attest is required to book a day's takings.
model ResultUnitIncome {
  id String @id @default(cuid())

  // One profile per unit. Cascade: deleting the unit takes its income settings
  // with it — but a unit with booked reports cannot be deleted anyway, because
  // IncomeReport restricts it.
  resultUnit   ResultUnit @relation(fields: [resultUnitId], references: [id], onDelete: Cascade)
  resultUnitId String     @unique

  // Stable identifier, matching the key intakt groups by, e.g. "cafe". Report
  // keys are "<key>-<date>", so changing this renames every future report. It
  // stays a field of its own rather than being derived from the unit's name:
  // the name is editable prose, the key is a contract with another program.
  key String @unique

  // What the rendered PDF calls it. Null means the result unit's own name,
  // which is the ordinary case — it is here only for a unit whose documents
  // need a different form of its name than the settings screens use.
  properName String?

  // "Sexmästeriets verksamhet" — becomes the verifikationstext, and with the
  // date it is how a day is recognised in Fortnox (lib/income/duplicate.ts).
  description String

  // Pre-filled on every report this unit produces. Still editable per report
  // before booking, which is the point of the review step.
  defaultCostCenter   CostCenter? @relation("IncomeDefaultCostCenter", fields: [defaultCostCenterId], references: [id], onDelete: SetNull)
  defaultCostCenterId String?

  // Whether it still takes money in. A retired verksamhet keeps its reports and
  // stops appearing in the routing table sent to intakt.
  active Boolean @default(true)

  prefixes IncomeProductPrefix[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// A product-name prefix and where it routes. A Zettle product called
// "s1 - Öl", or a Swish message reading "c-Cola", is matched on the part before
// the separator.
//
// Several prefixes share a verksamhet on purpose: Sexmästeriet sells beer, wine
// and spirits, which are one verksamhet but three revenue accounts. That is the
// whole reason this is a separate table and not a column on ResultUnitIncome.
model IncomeProductPrefix {
  id   String @id @default(cuid())
  // Stored lower-case; matching is case-insensitive. Unique across every
  // verksamhet, since a prefix that routed two ways would be ambiguous.
  code String @unique

  income   ResultUnitIncome @relation(fields: [incomeId], references: [id], onDelete: Cascade)
  incomeId String

  // BAS revenue account, e.g. "3011". A string, like everywhere else accounts
  // appear, and validated against Account rather than related to it — a prefix
  // may name an account Fortnox has since retired.
  account String

  // Products matching no prefix at all fall back to exactly one prefix, marked
  // here. Without it an unrecognised product has nowhere to go; with more than
  // one the fallback would be ambiguous, so the API enforces a single row.
  isFallback Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([incomeId])
}

// Swish payments whose message carries no usable prefix, matched on the exact
// amount instead. Someone who swishes 13,00 kr with an empty message has
// almost certainly bought a Cola.
//
// A guess, and knowingly so — which is why it is a small explicit table a
// treasurer maintains, rather than anything inferred.
model SwishAmountFallback {
  // Öre. The primary key: one guess per amount, or it would be ambiguous.
  amount  Int    @id
  // A product message run through the normal prefix pipeline, e.g. "c-Cola",
  // so it routes exactly as a labelled payment would.
  message String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Resultatenhet — Styrelsen, Sexmästeriet, and the rest. Which cost centres
// belong to it is decided entirely by its prefixes: a cost centre whose code
// starts with one of them is part of the result unit. Nothing is stored on
// CostCenter, so the two can never disagree.
model ResultUnit {
  id   String @id @default(cuid())
  name String @unique // "Skattmästeriet"

  prefixes ResultUnitPrefix[]
  owners   ResultUnitOwner[]

  // The income half, for a unit that takes money in — see ResultUnitIncome.
  // Optional, and read by nothing outside the income module.
  income        ResultUnitIncome?
  incomeReports IncomeReport[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// A cost-centre code prefix owned by a result unit, e.g. "SKT" for SKT01/SKT02.
// Prefixes are globally unique AND non-overlapping: no prefix may be an
// extension of another, so at most one can ever match a given code and
// membership is unambiguous. The overlap rule is enforced in the API, since
// the database can't express "no row is a prefix of another".
model ResultUnitPrefix {
  id           String     @id @default(cuid())
  resultUnit   ResultUnit @relation(fields: [resultUnitId], references: [id], onDelete: Cascade)
  resultUnitId String
  value        String     @unique // stored upper-case

  createdAt DateTime @default(now())

  @@index([resultUnitId])
}

// Resultatansvarig ↔ resultatenhet. Many-to-many: one person may answer for
// several result units and a result unit may have several ansvariga. This drives
// attest authority: a resultatansvarig may attest/handle allocations whose cost
// centre belongs to a result unit they own (see lib/permissions.ts).
model ResultUnitOwner {
  id String @id @default(cuid())

  resultUnit   ResultUnit @relation(fields: [resultUnitId], references: [id], onDelete: Cascade)
  resultUnitId String

  user   User   @relation("ResultUnitOwnerUser", fields: [userId], references: [id], onDelete: Cascade)
  userId String

  createdAt DateTime @default(now())

  @@unique([userId, resultUnitId])
  @@index([resultUnitId])
}

model Expense {
  id        String  @id @default(cuid())
  // Human-readable, e.g. "DEK26-0042" — see lib/domain/reference.ts. Null until
  // the utlägg is submitted for attest: a draft is not yet a claim on the
  // section, and numbering one would burn a number every time someone opens the
  // wizard and walks away. Pages and API routes are keyed on `id`, not on this.
  reference String? @unique
  title     String

  submitter   User   @relation("ExpenseSubmitter", fields: [submitterId], references: [id])
  submitterId String

  paymentType PaymentType
  status      ExpenseStatus @default(DRAFT)

  // Receipt / OCR-derived details (editable until signed).
  purchaseDate DateTime? @db.Date
  grossAmount  Int? // öre
  currency     String    @default("SEK")

  // One-to-one match to a bank transaction (the correctness source of truth).
  matchedTransaction   BankTransaction? @relation(fields: [matchedTransactionId], references: [id], onDelete: SetNull)
  matchedTransactionId String?          @unique

  // The rendered utläggsräkning — the cover page naming who attested what,
  // written to object storage at export. The same shape as IncomeReport's, for
  // the same reason: it is the document that substantiates the voucher.
  //
  // At export rather than at booking, because that is the moment the page stops
  // being a rendering and becomes evidence: these bytes are what Fortnox holds.
  // Before it, the document route draws one on the way past and keeps nothing,
  // so a cover previewed on a BOOKED utlägg always shows the attestations as
  // they stand.
  //
  // The cover *only*, never the receipt merged into it. The two are stored
  // apart and joined on the way out (lib/server/pdf-merge.ts), so the receipt's
  // bytes are held once rather than twice — and since both objects are
  // immutable, the merge is reproducible without archiving its result.
  //
  // Cleared by `unexport`, which exists precisely to amend an utlägg that has
  // already gone over: the cover describes the version being amended.
  documentKey      String?
  documentFilename String?

  allocations  ExpenseCostAllocation[]
  receipts     Receipt[]
  events       ExpenseEvent[]
  verification Verification? // the booked voucher, once status reaches BOOKED
  // Stock bought on this utlägg. The receipt on it is the purchase
  // documentation the lagerbokföring would otherwise have to ask for again.
  stockEntries StockEntry[]            @relation("StockPurchaseExpense")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ── What the list screens actually ask for ──────────────────────
  //
  // Filtering, sorting and paging all happen in the database (see
  // lib/data/expenses.ts). That only costs what it is supposed to cost if the
  // ordering is one an index can hand over already sorted — otherwise every
  // page of 25 is a full sort of everything that matched, and LIMIT/OFFSET
  // reads the whole set to throw most of it away. The bare @@index([status])
  // and @@index([submitterId]) these replace served the filters and left every
  // ORDER BY to a sort.
  //
  // Each ends in `id` because every ordering the app issues does: a page is a
  // window onto an ordering, and an ordering with ties is a window that can
  // show one row twice and skip another. Postgres scans a btree in either
  // direction, so one index covers both asc and desc.
  //
  // What is deliberately not here: `title`, `paymentType` and `submitter.name`.
  // Those are sorts someone chooses by clicking a column, on a table holding a
  // section's utlägg rather than a bank's — the sort is milliseconds, and an
  // index apiece would be paid for on every write to buy that back. `reference`
  // needs none either; it is unique, so it already has one.
  //
  // And the honest limit of all of them: a query can use one index. Filtering
  // by status *and* sorting by amount will use whichever Postgres judges the
  // better of the two and sort or filter the rest by hand. There is no index
  // set that makes every combination free.

  // The default order of every list, and of the dashboard.
  @@index([createdAt, id])
  // A status tab in that same order — the most common shape in the app.
  @@index([status, createdAt, id])
  // "My utlägg, newest first": the dashboard, and the expenses page's MINE view.
  @@index([submitterId, createdAt, id])
  // Both the date-range filter and the date column sort.
  @@index([purchaseDate, id])
  // The amount column sort.
  @@index([grossAmount, id])
}

// One cost-centre slice of an expense. An expense may span several cost centres
// with a fixed SEK amount each; all amounts must sum to grossAmount.
// Each allocation is individually approved by that cost centre's designated approver.
model ExpenseCostAllocation {
  id           String     @id @default(cuid())
  expense      Expense    @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  expenseId    String
  costCenter   CostCenter @relation(fields: [costCenterId], references: [id])
  costCenterId String
  amount       Int // öre
  comment      String? // optional note from the submitter

  approvedBy   User?     @relation("AllocationApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedById String?
  approvedAt   DateTime?

  @@unique([expenseId, costCenterId])
  @@index([expenseId])
  // The other direction: "every utlägg touching one of these cost centres",
  // which is how a resultatansvarig's scope is resolved (lib/data/expense-scope.ts)
  // and how their attest queue is filtered. Without it that walked the whole
  // allocation table on every list they open.
  @@index([costCenterId])
}

// An uploaded receipt image/PDF (stored in MinIO) plus its OCR result.
//
// One per utlägg. The relation is a list because that is how Prisma spells the
// other side of a foreign key, not because there is ever more than one: uploading
// is a replace, and the previous receipt's object and row go in the same
// transaction the new one arrives in (api/expenses/[id]/receipts/route.ts). So
// "the utlägg's receipt" and "its newest receipt" are the same thing, and code
// that takes the newest is reading the only one.
model Receipt {
  id        String  @id @default(cuid())
  expense   Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  expenseId String

  objectKey String // MinIO object key (the display-normalised file)
  filename  String
  mimeType  String // the stored file's type (images are normalised to image/jpeg)
  byteSize  Int?

  ocrText   String? // raw extracted text
  ocrResult Json? // structured OCR pre-fill (amount, vat, merchant, date…)

  uploadedBy   User?   @relation("ReceiptUploader", fields: [uploadedById], references: [id], onDelete: SetNull)
  uploadedById String?

  createdAt DateTime @default(now())

  @@index([expenseId])
}

// A row from an imported bank CSV. Negative amount = money out.
model BankTransaction {
  id              String   @id @default(cuid())
  // Transdag from the CSV — the day the purchase was made, not the day the
  // bank settled it. That is the date on the member's receipt.
  transactionDate DateTime @db.Date
  description     String
  amount          Int // öre, negative = outgoing
  currency        String   @default("SEK")

  // Dedup key for re-imported CSVs (hash of date+amount+description+row).
  importHash String?  @unique
  importedAt DateTime @default(now())

  // Which section card made this purchase (from the card number in the CSV).
  card      Card?   @relation(fields: [cardId], references: [id], onDelete: SetNull)
  cardId    String?
  cardLast4 String? // raw last 4 from the CSV; resolved to a Card by last4

  matchedExpense Expense? @relation

  // The same reasoning as on Expense: the bank feed is filtered, sorted and
  // paged in the database (lib/data/bank.ts), so its default ordering carries
  // its tiebreaker into the index. The description and card-number sorts are
  // left to a sort for the same reason the equivalents on Expense are.
  @@index([transactionDate, id]) // default order, and the date-range filter
  @@index([amount, id]) // the amount column sort
  @@index([cardId]) // "this member's card purchases"
}

// A physical section card ("sektionskort"). Only some members hold one; the
// card number's last 4 digits appear in the bank CSV, which lets us attribute a
// card purchase to its holder so they can account for it. Admin-assigned.
model Card {
  id       String  @id @default(cuid())
  last4    String  @unique
  holder   User?   @relation("CardHolder", fields: [holderId], references: [id], onDelete: SetNull)
  holderId String?
  active   Boolean @default(true)

  transactions BankTransaction[]

  createdAt DateTime @default(now())

  @@index([holderId])
}

model ExpenseEvent {
  id        String           @id @default(cuid())
  expense   Expense          @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  expenseId String
  type      ExpenseEventType

  actor   User?   @relation("EventActor", fields: [actorId], references: [id], onDelete: SetNull)
  actorId String?

  comment String? // e.g. reason on CHANGES_REQUESTED / REJECTED
  diff    Json? // snapshot of what changed on EDITED

  createdAt DateTime @default(now())

  @@index([expenseId])
  @@index([type])
}

// A bookkeeping voucher (verifikation). Its lines must balance (sum debit ==
// sum credit), whatever produced it.
//
// It hangs off exactly one of two things: an Expense (money going out — an
// utlägg or a card purchase) or an IncomeReport (money coming in — a day's
// takings). Both are the same object to a bookkeeper and to Fortnox, so they
// are one table rather than two: the export path, the Fortnox voucher columns
// and the balance rule are written once and both sides get them.
//
// "Exactly one" is not expressible in Prisma — both columns are nullable and
// separately unique, which permits neither being set as readily as both. A
// CHECK constraint in the migration is what actually enforces it.
model Verification {
  id String @id @default(cuid())

  expense   Expense? @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  expenseId String?  @unique

  incomeReport   IncomeReport? @relation(fields: [incomeReportId], references: [id], onDelete: Cascade)
  incomeReportId String?       @unique

  date        DateTime @db.Date
  description String // verifikationstext

  createdBy   User?   @relation("VerificationCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdById String?

  lines VerificationLine[]

  // Set once the voucher has been exported to Fortnox. The series+number+year
  // identify the booked verifikation in Fortnox; exportedAt marks success.
  fortnoxSeries String?
  fortnoxNumber Int?
  fortnoxYear   Int?
  exportedAt    DateTime?

  createdAt DateTime @default(now())
}

// The org's SERVICE connection to Fortnox: a Fortnox service account, authorised
// once by a Fortnox system administrator, not tied to any person. There is at
// most one (the whole section books into a single Fortnox company), so the app
// treats this table as a singleton. It backs everything that READS from Fortnox
// — the ledger sync, the chart of accounts, cost centres — including the
// scheduled job, which is why it must survive people coming and going.
//
// Tokens are refreshed in place: the refresh token is long-lived (~45 days) but
// ROTATES on every use, so the new pair must be persisted on each refresh.
// Token columns are encrypted at rest (lib/secrets.ts).
model FortnoxConnection {
  id            String   @id @default(cuid())
  accessToken   String
  refreshToken  String
  expiresAt     DateTime // when the access token expires
  scopes        String // space-delimited granted scopes
  tokenType     String   @default("Bearer")
  voucherSeries String   @default("A") // default verifikationsserie for exports
  companyName   String? // from /3/companyinformation, for display
  orgNumber     String? // organisationsnummer — personal logins are checked against it

  connectedBy   User?   @relation("FortnoxConnector", fields: [connectedById], references: [id], onDelete: SetNull)
  connectedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// A bookkeeper's PERSONAL Fortnox login, one row per app user. Everything that
// WRITES to Fortnox (creating vouchers, attaching receipts) runs on this token
// rather than the service account, so Fortnox stamps the voucher with the
// person's name instead of the integration's.
//
// Deliberately short-lived: `sessionExpiresAt` is our own hard cap (a few
// hours). Inside it the ~1h Fortnox access token is refreshed silently; past it
// the row is useless and the bookkeeper has to log in to Fortnox again. Tokens
// are encrypted at rest (lib/secrets.ts).
model FortnoxUserSession {
  id     String @id @default(cuid())
  user   User   @relation("FortnoxUserSession", fields: [userId], references: [id], onDelete: Cascade)
  userId String @unique

  accessToken      String
  refreshToken     String
  tokenExpiresAt   DateTime // when the Fortnox access token expires (~1h)
  sessionExpiresAt DateTime // our cap — no refresh past this, log in again
  scopes           String

  // Who Fortnox says this is, from /3/me — shown in the UI so a bookkeeper can
  // tell which Fortnox identity their exports will be signed with.
  fortnoxUserName  String?
  fortnoxUserEmail String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ── Fortnox ledger mirror (read side) ─────────────────────────────
// A local copy of what's actually been bookkept in Fortnox, pulled via the SIE
// export (one file per financial year). This is the whole general ledger — not
// just vouchers this app created — so it backs spend reporting (per account per
// cost centre) and budget-vs-actual. Synced by replacing a whole year at a time
// (idempotent), so closed years stay stable and the current year just re-pulls.

model FortnoxFinancialYear {
  id         Int       @id // Fortnox financial-year id (not the calendar year)
  fromDate   DateTime  @db.Date
  toDate     DateTime  @db.Date
  lastSyncAt DateTime?

  vouchers LedgerVoucher[]
  balances LedgerAccountBalance[]
}

model LedgerVoucher {
  id            String               @id @default(cuid())
  financialYear Int // FortnoxFinancialYear.id
  year          FortnoxFinancialYear @relation(fields: [financialYear], references: [id], onDelete: Cascade)
  series        String // VoucherSeries, e.g. "A"
  number        Int // VoucherNumber within the series+year
  date          DateTime             @db.Date // transaction date
  description   String

  rows       LedgerRow[]
  importedAt DateTime    @default(now())

  @@unique([financialYear, series, number])
  @@index([date])
}

// Per-account opening/closing balance for a financial year, from the SIE
// #IB/#UB records. Needed by the balance report: balance-sheet accounts carry
// history from earlier years, so the year's vouchers alone only give the
// movement, not the actual balance. Replaced wholesale alongside the year's
// vouchers, so it stays as idempotent as the rest of the mirror.
model LedgerAccountBalance {
  financialYear  Int
  year           FortnoxFinancialYear @relation(fields: [financialYear], references: [id], onDelete: Cascade)
  account        String // BAS account number
  accountName    String // denormalised from the SIE #KONTO chart
  // "" is the account-level total (#IB/#UB). A non-empty code is the optional
  // per-cost-centre breakdown (#OIB/#OUB), which an exporter may omit — so the
  // account-level row is the only one guaranteed to exist. Empty string rather
  // than null because it is part of the primary key.
  costCenterCode String               @default("")

  opening Int // öre at period start (#IB), positive = debit
  closing Int // öre at period end (#UB), positive = debit

  @@id([financialYear, account, costCenterCode])
  @@index([account])
}

model LedgerRow {
  id        String        @id @default(cuid())
  voucher   LedgerVoucher @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  voucherId String

  // Denormalised from the voucher, like accountName and costCenterName above,
  // and for the same kind of reason — except that this pair is about what can
  // be indexed rather than what can be read. Every report and every
  // budget-vs-actual figure asks for one financial year, usually a month range
  // inside it; expressed through the relation that is a join against
  // LedgerVoucher before any index on this table can be reached, on what is by
  // far the largest table in the app. Held here, the same questions are a
  // straight indexed scan.
  //
  // Kept in step by being written once: a year's rows are deleted and
  // re-inserted wholesale on every sync (see lib/fortnox/sync.ts), so these can
  // no more drift from the voucher than accountName can.
  financialYear Int
  date          DateTime @db.Date

  account        String // BAS account number, e.g. "6071"
  accountName    String // denormalised from the SIE #KONTO chart
  // Cost centre (SIE dimension 1). Code matched to an app CostCenter by string;
  // some Fortnox codes have no app counterpart, so this stays a denormalised
  // string rather than a FK.
  costCenterCode String?
  costCenterName String?
  project        String?
  text           String? // SIE transaction text

  debit  Int // öre
  credit Int // öre

  // The two shapes every reader actually asks in: a period within a year (the
  // report's movements, and the budget's actuals, which take the whole year),
  // and one account within a year (the drill-down behind a report cell).
  //
  // These replace a bare @@index([account]) and @@index([costCenterCode]).
  // Neither was reachable for the queries above — both start by narrowing to a
  // financial year — and nothing asks about an account, or a cost centre,
  // across all years. An index that answers nothing is not free here: a sync
  // re-inserts tens of thousands of rows at a time and pays for every one.
  @@index([financialYear, date])
  @@index([financialYear, account])
  @@index([voucherId])
}

// ── Budget ────────────────────────────────────────────────────────

// A budget: a year, a name, and everything budgeted in it.
enum BudgetAccountKind {
  INCOME // intäkt
  COST // kostnad
}

// Budgets stand alone. Any number may share a year — the adopted one and a
// revision drafted beside it are simply two budgets — and none of them knows
// anything about the others. Copying one duplicates its contents and then the
// two go their separate ways: no lineage is stored, nothing is shared, and
// changing this one's year or name moves nothing else.
//
// They stay comparable all the same, because what they are made of lines up on
// its own: cost-centre codes, account codes and row descriptions mean the same
// thing in every budget of every year. lib/budget/compare.ts joins any number of
// them on exactly that, keeping what only one side has rather than dropping it.
//
// Locking freezes one budget: it then rejects every write to its numbers — rows,
// accounts, cost centres, variables, its own name and year, and being deleted —
// while comments stay open, since those are a discussion about the frozen
// figures rather than an edit to them. Only the skattmästare may lock or unlock
// (see canLockBudget in lib/permissions.ts); the guard every budget write goes
// through is lib/budget/access.ts.
//
// A locked budget still moves, but only one way: through a BudgetChange, which
// adjusts the figures without touching a single row of what was adopted. That is
// the whole reason the lock is worth having — see BudgetChange below.
model Budget {
  id          String   @id @default(cuid())
  year        Int
  name        String // "Ursprunglig", "VTM-extra"
  createdBy   User     @relation("BudgetAuthor", fields: [createdById], references: [id])
  createdById String
  createdAt   DateTime @default(now())

  // Null while open. Both are set together — the timestamp is what the app
  // tests, the locker is who to name in the UI.
  lockedAt   DateTime?
  lockedBy   User?     @relation("BudgetLocker", fields: [lockedById], references: [id], onDelete: SetNull)
  lockedById String?

  variables   BudgetVariable[]
  costCenters BudgetCostCenter[]
  changes     BudgetChange[]

  @@index([year])
}

// Named global value or expression. Expressions may reference other variables
// or account totals via account(CC_CODE, ACCT_CODE). Evaluated with
// fixed-point iteration so cross-cost-center references resolve correctly.
model BudgetVariable {
  id         String @id @default(cuid())
  budget     Budget @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  budgetId   String
  name       String // identifier, e.g. "MEMBERS"
  expression String // e.g. "300", "TICKET_PRICE * MEMBERS", "account(INFU,3010)"
  sortOrder  Int    @default(0)

  @@unique([budgetId, name])
  @@index([budgetId])
}

// A cost center included in a budget. Ordered by sortOrder.
//
// The link to a real cost centre is optional: a sheet cloned inside a budget
// starts detached, since the code it would copy is already taken by its source
// (and a budget is often drafted before the cost centre exists in Fortnox at
// all). A detached sheet budgets normally but stands outside the A1 grid — it
// has no code for `account(CC, ACCT)` or a `CC!C7` reference to name — until an
// unused cost centre is picked for it. `label` is what it is called meanwhile;
// once linked, the cost centre's own code and name take over. The label is also
// what a detached sheet is matched on when budgets are compared, since its id
// means nothing to any other budget (see lib/budget/compare.ts).
// The unique pair still holds where it matters: Postgres treats each NULL as
// distinct, so any number of detached sheets may coexist while a linked cost
// centre still cannot appear twice in one budget.
model BudgetCostCenter {
  id           String          @id @default(cuid())
  budget       Budget          @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  budgetId     String
  costCenter   CostCenter?     @relation(fields: [costCenterId], references: [id])
  costCenterId String?
  label        String? // display name while detached
  sortOrder    Int             @default(0)
  accounts     BudgetAccount[]

  @@unique([budgetId, costCenterId])
  @@index([budgetId])
}

// A BAS account within a cost center. Line items beneath it must sum to its
// total; the total is derived — never stored — to stay consistent. Editorial
// adjustments (BudgetAdjustment) are added on top of that sum, so the account
// total is "what was adopted, plus what has been decided since".
model BudgetAccount {
  id                 String             @id @default(cuid())
  budgetCostCenter   BudgetCostCenter   @relation(fields: [budgetCostCenterId], references: [id], onDelete: Cascade)
  budgetCostCenterId String
  accountCode        String // e.g. "3010"
  accountName        String // e.g. "Biljettintäkter"
  sortOrder          Int                @default(0)
  // Income vs. cost. When null the kind is inferred from the account code
  // (BAS: 3xxx = income, everything else = cost); set to override.
  kindOverride       BudgetAccountKind?
  lineItems          BudgetLineItem[]
  comments           BudgetComment[]
  adjustments        BudgetAdjustment[]

  @@unique([budgetCostCenterId, accountCode])
  @@index([budgetCostCenterId])
}

// One line item beneath an account. Amount is an expression string so it
// can reference variables (e.g. "MEMBERS * TICKET_PRICE").
model BudgetLineItem {
  id          String        @id @default(cuid())
  account     BudgetAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  accountId   String
  description String
  // When both `quantity` and `unitPrice` are set the amount is their product
  // (the "antal × á-pris" form); otherwise `expression` is used directly.
  // All three are expression strings, so they may reference variables.
  quantity    String? // e.g. "2", "MEMBERS", "PASLAG_OL"
  unitPrice   String? // e.g. "350", "TACK_POLICY"
  expression  String // e.g. "1500", "MEMBERS * 5"
  sortOrder   Int           @default(0)
  // Per-line values for the six general columns, keyed x1…x6 (see
  // EXTRA_COLUMN_KEYS in lib/budget/grid.ts). Each holds a literal or formula
  // string, exactly like `expression`.
  values      Json          @default("{}")

  @@index([accountId])
}

// ── Redaktionella ändringar ───────────────────────────────────────
//
// What a locked budget is allowed to do. An adopted budget is voted through and
// then sealed, but the year goes on: a sittning costs more than it was budgeted
// to, a resultatenhet wants to spend one post's money on another. Rather than reopen
// the adopted figures — which would quietly rewrite what was voted for — the
// change is recorded beside them and added on top. The sheet shows the new
// number, and it shows where it came from.
//
// Two kinds, told apart by their effect on the rambudget rather than by what the
// treasurer calls them (see lib/budget/changes.ts, which does the arithmetic):
//
//   AVSTEG        — a departure from the adopted frame. The section's bottom
//                   line moves, and that is exactly what must be visible.
//   FORFLYTTNING  — money moved between accounts inside one resultatenhet
//                   (Sexmästeriet and its cost centres). The bottom line is
//                   untouched, so the entries must cancel out exactly.
//
// A change is never edited and never quietly disappears. Wrongly entered, it is
// revoked: it stops counting towards the figures the moment it is, and stays in
// the history struck through, with who revoked it and when. Undoing a real
// decision is a new, opposite change instead — the history is the record of what
// happened, not of what the numbers currently are.
//
// Only the skattmästare may make one, and only on a locked budget: on an open
// one there is nothing to depart from, and the figures are simply edited.
enum BudgetChangeKind {
  AVSTEG
  FORFLYTTNING
}

model BudgetChange {
  id       String           @id @default(cuid())
  budget   Budget           @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  budgetId String
  // Running number within the budget, from 1 — what a change is called out loud
  // ("avsteg #4") and in the sheet, since a cuid is no use to anyone.
  seq      Int
  kind     BudgetChangeKind
  reason   String // motivering, required — a bare number explains nothing

  createdBy   User     @relation("BudgetChangeAuthor", fields: [createdById], references: [id])
  createdById String
  createdAt   DateTime @default(now())

  // Set together when the change is revoked. `revokedAt` is what the arithmetic
  // tests; the revoker is who to name in the history.
  revokedAt   DateTime?
  revokedBy   User?     @relation("BudgetChangeRevoker", fields: [revokedById], references: [id], onDelete: SetNull)
  revokedById String?

  entries BudgetAdjustment[]

  @@unique([budgetId, seq])
  @@index([budgetId])
}

// One account's share of a change: a signed amount in the account's own
// orientation, i.e. the same direction its line items are budgeted in. +500 on a
// cost account is 500 kr more spent; +500 on an income account is 500 kr more
// earned. What that does to the result is a separate question, and the reason
// the two kinds can be told apart at all — see resultImpact in
// lib/budget/changes.ts.
//
// Stored as a decided number rather than an expression: the rest of the budget
// is formulas so it can be redrafted, but a change is a decision about an amount
// and must still be that amount after a variable moves — otherwise a
// förflyttning that summed to zero when it was made might not tomorrow.
model BudgetAdjustment {
  id        String        @id @default(cuid())
  change    BudgetChange  @relation(fields: [changeId], references: [id], onDelete: Cascade)
  changeId  String
  // Cascades so deleting a whole budget still works. Deleting a single account
  // that carries adjustments is refused by the API instead, which is where the
  // history is worth protecting.
  account   BudgetAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  accountId String
  // Öre, signed in the account's own orientation — the same units as every
  // other amount in this database, and the same the evaluator now reports in.
  // This was a Float holding kronor, which is the one thing the note at the top
  // of this file says money is never stored as: two decided amounts that ought
  // to cancel could miss by a fraction of an öre, and `isNeutral` in
  // lib/budget/changes.ts carried a half-öre epsilon to paper over it.
  amount    Int

  @@index([changeId])
  @@index([accountId])
}

// Approver comment on a specific account within a budget. Not copied when a
// budget is duplicated — a comment is a discussion about the figures in front of
// it, not part of them.
model BudgetComment {
  id        String        @id @default(cuid())
  account   BudgetAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  accountId String
  author    User          @relation("BudgetCommentAuthor", fields: [authorId], references: [id])
  authorId  String
  body      String
  createdAt DateTime      @default(now())

  @@index([accountId])
}

// ── One posting row (konteringsrad) ──────────────────────────────
// One posting row (konteringsrad): an account, an optional cost center, and a
// debit or credit amount (öre). A row normally has one of debit/credit set.
model VerificationLine {
  id             String       @id @default(cuid())
  verification   Verification @relation(fields: [verificationId], references: [id], onDelete: Cascade)
  verificationId String

  account     String // BAS account number, e.g. "1930"
  accountName String // denormalised label at booking time (chart may change)
  description String?

  costCenter   CostCenter? @relation(fields: [costCenterId], references: [id], onDelete: SetNull)
  costCenterId String?

  debit     Int @default(0) // öre
  credit    Int @default(0) // öre
  sortOrder Int @default(0)

  @@index([verificationId])
}

// ── Income batches (intäkter) ─────────────────────────────────────
// What the intakt service returned, held so it survives a page reload and so
// booking is reproducible. This is the old pending.yaml: a list of reports
// waiting to be reviewed and booked, except that it is per-user, reviewable in
// the app, and cannot be half-edited by hand.

enum IncomeSource {
  ZETTLE // card takings, from the Zettle purchase API
  ZETTLE_FEE // Zettle's own transaction fees — a cost, not income
  SWISH // from an uploaded Swish CSV export
}

// There used to be an EXCLUDED between DRAFT and BOOKED — a day deliberately
// skipped, carried over from the manifest file this replaced, where skipping
// meant deleting a line. It was a state nobody needed: a fetch is a working
// set, so a day you do not book is simply a day you do not book, and the next
// fetch clears it (see createSalesBatch). Keeping it meant every query that
// meant "unbooked" had to name two statuses and every screen had to say which
// one a row was in.
enum IncomeReportStatus {
  DRAFT // fetched, not yet booked
  BOOKED // a Verification exists
  EXPORTED // and it has reached Fortnox
}

// One fetch: a source and a date range, pulled once. Grouping reports under
// the run that produced them is what makes "what did I import on Tuesday"
// answerable, and what lets a whole bad import be discarded in one go.
model IncomeBatch {
  id     String       @id @default(cuid())
  source IncomeSource

  fromDate DateTime @db.Date
  toDate   DateTime @db.Date

  // The uploaded export's filename, for SWISH. Nothing reads it — it is there
  // so a treasurer can tell two imports apart.
  filename String?

  createdBy   User?   @relation("IncomeBatchCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdById String?

  reports IncomeReport[]

  createdAt DateTime @default(now())

  @@index([createdAt, id])
  @@index([source, createdAt, id])
}

// One committee's takings for one day: one PDF, one voucher.
model IncomeReport {
  id      String      @id @default(cuid())
  batch   IncomeBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  batchId String

  // Denormalised from the batch, and not merely for convenience. A report key
  // is "<verksamhet>-<date>", which a Zettle report and a Swish report for the
  // same unit and day both answer to — the source is what tells them apart, and
  // it has to be reachable without joining the batch for the already-booked
  // check below to be an index lookup.
  source IncomeSource

  // Null for ZETTLE_FEE, which is not attributable to a verksamhet.
  //
  // The unit rather than its income profile: whose takings these were is a fact
  // about the section, and it must survive someone deciding the unit no longer
  // sells anything and removing its income settings.
  resultUnit   ResultUnit? @relation(fields: [resultUnitId], references: [id], onDelete: Restrict)
  resultUnitId String?

  date  DateTime @db.Date
  total Int // öre

  status IncomeReportStatus @default(DRAFT)

  // Pre-filled from the committee, then editable in review. This is the one
  // field the old workflow made a person edit a YAML file for.
  costCenter   CostCenter? @relation(fields: [costCenterId], references: [id], onDelete: SetNull)
  costCenterId String?

  // The report this one repeats: same source, same verksamhet, same day, and
  // already booked here. Set at import, and the reason the row is shown as a
  // warning rather than left out of the fetch — a day that simply is not there
  // reads as takings gone missing. Booking it is refused; the partial unique
  // index over booked reports would refuse it anyway.
  duplicateOf   IncomeReport?  @relation("IncomeReportDuplicate", fields: [duplicateOfId], references: [id], onDelete: SetNull)
  duplicateOfId String?
  duplicates    IncomeReport[] @relation("IncomeReportDuplicate")

  // A voucher Fortnox already holds for this verksamhet on this day — "IR-142".
  //
  // Set at import, when the range is checked against Fortnox's own IR series
  // (lib/income/duplicate.ts). The day is imported all the same: the section may
  // genuinely have two, and refusing to show it would be deciding that for
  // whoever is reviewing. It is flagged instead, and booking it is their call.
  existingVoucher String?

  // The rendered intäktsräkning in object storage, written when the report is
  // booked. Stored exactly like a Receipt, because that is what it is: the
  // document that substantiates the voucher, and the file that gets attached
  // to it in Fortnox.
  documentKey      String?
  documentFilename String?

  lines        IncomeLine[]
  verification Verification?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Two reports for the same source, unit and day are the same takings
  // imported twice. Booking both would double the section's income, and the
  // old CLI had nothing stopping it — re-running upload simply wrote the
  // vouchers again.
  //
  // Not a unique constraint, because re-fetching a range after a failure is
  // normal and must stay possible. The uniqueness that matters is over
  // *booked* reports only, which Postgres expresses as a partial index and
  // Prisma cannot — so it is added by hand in the migration.
  @@index([source, resultUnitId, date])
  @@index([batchId])
  @@index([status, date, id])
}

// One product line of a report. Kept because the review screen shows them and
// the PDF is rendered from them — the service is stateless, so the report has
// to be sent back to it to be rendered.
model IncomeLine {
  id       String       @id @default(cuid())
  report   IncomeReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  reportId String

  name    String
  variant String?

  // BAS revenue account this line routed to, and its name at import time —
  // denormalised for the same reason VerificationLine.accountName is: the
  // chart of accounts may change, the booked document may not.
  account     String
  accountName String

  quantity  Int
  unitPrice Int // öre
  discount  Int @default(0) // öre, this line's share of any purchase discount
  total     Int // öre — quantity*unitPrice - discount

  sortOrder Int @default(0)

  @@index([reportId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Alkohollager — the bar's stock, and the law's reason for it.
//
// Serving alcohol under a permit means keeping a lagerbokföring: a record of
// what came in, what went out, and what is on the shelf, that holds up when
// somebody asks to see it. Two things follow from that and shape everything
// below.
//
// The log is the record. `StockEntry` is append-only — never updated, never
// deleted — and what is on hand is the sum of it, not a column somebody edits.
// A quantity that can be quietly changed is a quantity nobody can defend; a log
// that can be replayed is. Mistakes are corrected by a new row naming the row it
// corrects (`correctsId`), which is also how a stocktake's discrepancy is
// written.
//
// And the measurement is kept, not just its conclusion. Spirits are measured by
// weighing the bottle, and grams become millilitres through the product's own
// calibration (see lib/stock/measure.ts). The grams are stored, so a tare
// corrected later can be applied to every historical figure. Store only the
// derived volume and a wrong constant is baked into the legal record for good.

/// How a product's stock is counted.
enum StockKind {
  /// Cans, bottles of beer, wares: whole units, and a delivery carries a
  /// best-before date.
  UNIT
  /// Spirits: sealed bottles are counted, opened ones are weighed. Two numbers
  /// per product — how many are open, and how much is in them together.
  VOLUME
}

/// The drink types a restaurangrapport is broken down by, named as
/// Folkhälsomyndigheten names them. Not our vocabulary to choose: the report is
/// filed against these words, and a category we invented would have to be
/// mapped onto them by hand every year.
///
/// Purchase volumes are required for the first five. FOLKOL and LATTDRYCK
/// appear in the turnover section only, and OVRIGT is everything this feature
/// tracks that the report never asks about — wares, cleaning supplies, the
/// glassware.
enum DrinkCategory {
  SPRITDRYCK
  VIN
  ANDRA_JASTA
  STARKOL
  ALKOHOLDRYCKSLIKNANDE
  FOLKOL
  LATTDRYCK
  OVRIGT
}

/// Why stock moved. Kept apart because the report keeps them apart: what was
/// bought is reported, what was served is turnover, and what was spilled is
/// neither.
enum StockEntryKind {
  /// Bought in. The only kind whose volume reaches the restaurangrapport's
  /// "inköpt volym".
  PURCHASE
  /// Served at an event, or otherwise consumed.
  SERVING
  /// Spilled, broken, poured away, out of date.
  WASTE
  /// What a count found that the log did not predict.
  COUNT
  /// An entry undoing or amending an earlier one. Never an edit.
  CORRECTION
}

/// Which weighing a reading belongs to.
enum StockReadingPhase {
  OUT
  BACK
  COUNT
}

/// A thing the bar keeps a stock of.
///
/// The calibration columns are the heart of it and are why a product is more
/// than a name. For a VOLUME product, `tareGrams` and `fullGrams` are what turn
/// a reading on the scale into millilitres without anyone needing to know the
/// liquid's density — the two weights bracket `nominalMl`, and everything in
/// between is linear.
model StockProduct {
  id       String        @id @default(cuid())
  name     String
  kind     StockKind
  category DrinkCategory

  /// Alcohol by volume, per cent — 40.00 for vodka, null for wares. Kept
  /// because litres of pure alcohol is volume × this, and nothing else can
  /// reconstruct it afterwards.
  abv Decimal? @db.Decimal(5, 2)

  /// UNIT: what one unit holds, in millilitres. 330 for a can. This is what
  /// turns a count of cans into the litres the report asks for.
  unitMl Int?

  /// VOLUME: the bottle as sold, in millilitres — 700.
  nominalMl Int?
  /// VOLUME: an empty bottle on the scale, in grams.
  tareGrams Int?
  /// VOLUME: a sealed bottle on the scale, in grams.
  fullGrams Int?

  /// What the bar charges, in öre, including VAT. The restaurangrapport asks
  /// for a "normalpris" per drink type; this is where that comes from.
  normalPriceOre Int?

  /// Below this, the overview says so. In units for UNIT, in millilitres for
  /// VOLUME. Null asks nothing.
  minimumLevel Int?

  active Boolean @default(true)

  entries StockEntry[]
  lots    StockLot[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active, category])
}

/// A delivery of countable stock, and the best-before that came with it.
///
/// UNIT only. Spirits do not go off, and a bottle cannot carry a date anyway —
/// open bottles here are anonymous, by the bar's own account of how it works.
model StockLot {
  id        String       @id @default(cuid())
  productId String
  product   StockProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  /// Null when a delivery arrived without one, which is not an error — it is
  /// simply a lot nothing can be said about.
  bestBefore DateTime? @db.Date
  receivedAt DateTime  @db.Date
  note       String?

  entries StockEntry[]

  createdAt DateTime @default(now())

  @@index([productId, bestBefore])
}

/// One movement of stock. The log, and the only thing that is true.
///
/// Every quantity is a signed delta — positive in, negative out — so on hand is
/// their sum and nothing has to be kept in step with anything. There is no
/// PATCH and no DELETE on this table anywhere in the app.
model StockEntry {
  id String @id @default(cuid())

  productId String
  product   StockProduct @relation(fields: [productId], references: [id], onDelete: Restrict)

  /// UNIT: which delivery this came off, so a return credits back the lot it
  /// left and keeps its best-before.
  lotId String?
  lot   StockLot? @relation(fields: [lotId], references: [id], onDelete: Restrict)

  kind StockEntryKind

  /// Whole units for a UNIT product; sealed bottles for a VOLUME one.
  units       Int @default(0)
  /// Millilitres of liquid in opened bottles. VOLUME only.
  volumeMl    Int @default(0)
  /// How the number of open bottles changed. VOLUME only, and separate from
  /// `volumeMl` because opening a bottle moves one without moving the other.
  openBottles Int @default(0)

  /// When it happened in the world, and when somebody wrote it down. They
  /// differ often — a Friday's serving entered on Monday — and the gap is the
  /// sort of thing an inspection asks about, so both are kept.
  occurredAt DateTime @db.Date

  actorId String
  actor   User   @relation("StockEntryActor", fields: [actorId], references: [id], onDelete: Restrict)

  /// The utlägg this was bought on. The receipt is already in this app, so a
  /// purchase row points at it rather than asking for the paperwork twice.
  expenseId String?
  expense   Expense? @relation("StockPurchaseExpense", fields: [expenseId], references: [id], onDelete: SetNull)

  /// A correction names what it corrects. Self-relation, so the chain is
  /// readable in both directions.
  correctsId  String?
  corrects    StockEntry?  @relation("StockCorrection", fields: [correctsId], references: [id], onDelete: Restrict)
  correctedBy StockEntry[] @relation("StockCorrection")

  note String?

  readings StockReading[]

  createdAt DateTime @default(now())

  @@index([productId, occurredAt])
  @@index([occurredAt])
  @@index([kind, occurredAt])
}

/// One bottle on the scale. The observation behind a VOLUME entry.
///
/// A row per bottle rather than a summed total, because the count is part of
/// the arithmetic: converting grams to millilitres subtracts one tare per
/// bottle (see lib/stock/measure.ts). A pre-summed figure could not be
/// recomputed if the tare were ever corrected, which is the whole reason these
/// are kept.
model StockReading {
  id      String     @id @default(cuid())
  entryId String
  entry   StockEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  grams Int
  phase StockReadingPhase

  createdAt DateTime @default(now())

  @@index([entryId])
}

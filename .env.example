# Copy to .env for local development:  cp .env.example .env
#
# Every variable the app reads is listed here — lib/env.ts is the code that
# resolves them, and the two are meant to stay in step.
#
# The values below are the ones local development already falls back to, so an
# empty .env works against docker-compose (`pnpm db:up`). In production none of
# them apply: the server checks its environment at startup and refuses to boot
# on anything still set to a development value.

# ── Required ──────────────────────────────────────────────────────────

# Postgres. Matches docker-compose (user/password/database all "utlagg").
DATABASE_URL=postgresql://utlagg:utlagg@localhost:5432/utlagg

# Signs the session JWTs. Generate a real one for production:
#   openssl rand -base64 32
AUTH_SECRET=dev-only-insecure-auth-secret

# Receipt storage (S3-compatible; MinIO locally, per docker-compose).
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=receipts
S3_ACCESS_KEY=utlagg
S3_SECRET_KEY=utlagg-dev-secret

# Sign-in, through the guild's Authentik (auth.dsek.se) — Google sits behind
# it, federated, so this app never talks to Google. Variable names match the
# guild's own web app (Dsek-LTH/web), so a value copied from there lands under
# the name it left.
#
# The values below are their public development client: no secret, and
# Authentik only accepts localhost redirects for it. That is enough to sign in
# with your real D-sektionen account while developing, and useless anywhere
# else — which is the point.
#
# For a deployment, register an application of your own in Authentik with
# redirect URI <origin>/api/auth/callback/authentik, and set all three. The
# server refuses to start in production without them (lib/server/env.ts): once
# the dev sign-in is gone, this is the only way in.
AUTH_AUTHENTIK_CLIENT_ID=SvRybUTCGqhNiw2Y3gn1wqt0YxpjW2sv9fbPsUaP
AUTH_AUTHENTIK_CLIENT_SECRET=Cyb77mtW81Kyd49fZsJlzIWbvwSPfGe4td5ep9YhSOQ=
AUTH_AUTHENTIK_ISSUER=https://auth.dsek.se/application/o/dev/

# ── Running the whole stack in Docker (`pnpm app:up`) ─────────────────
# The app container runs the production build, so lib/server/env.ts holds it to
# production rules: every variable above must be set, the Authentik ones
# included. The check asks only whether a value is there, not what it is — so the
# stack starts with the values in this file, and starting is not the same as
# being configured. Two of them are yours to replace anyway, because nothing
# else will:
#
#   AUTH_SECRET     openssl rand -base64 32     signs every session
#   S3_SECRET_KEY   openssl rand -base64 24     also MinIO's root password
#
# Change them here rather than anywhere else: `pnpm dev` reads the same file,
# and docker-compose hands MinIO the same S3_ACCESS_KEY/S3_SECRET_KEY as its
# root credentials, so the two stay in step. DATABASE_URL and S3_ENDPOINT are
# the exception — compose overrides them, because "localhost" inside a
# container is the container.

# ── Optional ──────────────────────────────────────────────────────────
# Nothing else is needed for sign-in: the endpoints Authentik serves are read
# from the issuer's discovery document, so the three variables above are the
# whole configuration.

# Fortnox integration. Leave empty to run without it: the bookkeeping export
# and the ledger sync then stay switched off, and the app says so rather than
# failing.
FORTNOX_CLIENT_ID=
FORTNOX_CLIENT_SECRET=
FORTNOX_REDIRECT_URI=http://localhost:3000/api/fortnox/callback

# Encrypts the stored Fortnox tokens (AES-256-GCM). Falls back to AUTH_SECRET
# when unset, which means rotating AUTH_SECRET forces a Fortnox reconnect —
# set this separately to decouple the two.
FORTNOX_TOKEN_KEY=
